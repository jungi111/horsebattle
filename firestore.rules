rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 회원 문서(프로필 + 지갑)는 본인만 읽고 쓴다
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
